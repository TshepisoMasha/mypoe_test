class Message {
 
    // Static arrays allows messages to be stored as the user wishes to
    private static ArrayList<Message> sentMessages = new ArrayList<>();
    private static ArrayList<Message> storedMessages = new ArrayList<>();
    private static ArrayList<Message> disregardedMessages = new ArrayList<>();
    private static int totalMessagesSent = 0;

    static String returnTotalMessages() {
        throw new UnsupportedOperationException("Not supported yet."); // Generated from nbfs://nbhost/SystemFileSystem/Templates/Classes/Code/GeneratedMethodBody
    }

    
    private String messageID; // this variable stores a uniqe 10 digits id
    private int messageNum; // the number of messages the user chooses to send
    private String recipient; // the +code that the recepient number is supposed to have
    private String messageText; // the message is not supposed to be more than 250 characters
    private String messageHash; // 

    // Constructor for normal use
    public Message(String recipient, String messageText) {
        this.messageID = generateMessageID();
        System.out.println("Message ID generated: " + messageID); // Required by table
        this.messageNum = ++totalMessagesSent;
        this.recipient = recipient;
        this.messageText = messageText;
        this.messageHash = createMessageHash();
    }

    // Constructor for JUnit tests which will allow the test to run without disturbing the progrem
    public Message(String recipient, String messageText, String testID) {
        this.messageID = testID;
        System.out.println("Message ID generated: " + messageID);
        this.messageNum = ++totalMessagesSent;
        this.recipient = recipient;
        this.messageText = messageText;
        this.messageHash = createMessageHash();
    }

    // Boolean: checkMessageID() - ID is not supposed to be more than 10 characters
    public boolean checkMessageID() {
        return this.messageID.length() == 10;
    }

    
    public static String checkRecipientCell(String cellNum) {
        String regex = "^\\+\\d{1,3}\\d{1,10}$"; // it must include a code and 10 digits that follow
        if (cellNum.matches(regex)) {
            return "Cell phone number successfully captured.";
        } else {
            return "Cell phone number is incorrectly formatted or does not contain an international code. Please correct the number and try again.";
        }
    }

    
    public String createMessageHash() {
        String firstTwo = messageID.substring(0, 2);
        String[] words = messageText.trim().split("\\s+");
        String firstWord = words[0].replaceAll("[^A-Za-z]", "").toUpperCase();
        String lastWord = words[words.length - 1].replaceAll("[^A-Za-z?]", "").toUpperCase();
        return firstTwo + ":" + messageNum + ":" + firstWord + lastWord;
    }

    
    public String SentMessage(int choice) {
        switch (choice) {
            case 1: // User selected 'Send Message'
                sentMessages.add(this);
                return "Message successfully sent.";

            case 2: // User selected 'Disregard Message'
                disregardedMessages.add(this);
                totalMessagesSent--;
                return "Press 0 to delete the message.";

            case 3: // User selected 'Store Message'
                storedMessages.add(this);
                storeMessage();
                return "Message successfully stored.";

            default:
                return "Invalid choice.";
        }
    }

    // String: printMessages() - Returns all sent messages
    public static String printMessages() {
        if (sentMessages.isEmpty()) {
            return "No sent messages.";
        }
        String result = "";
        for (int i = 0; i < sentMessages.size(); i++) {
            Message m = sentMessages.get(i);
            result += "Message ID: " + m.messageID +
                      "\nMessage Hash: " + m.messageHash +
                      "\nRecipient: " + m.recipient +
                      "\nMessage: " + m.messageText + "\n\n";
        }
        return result;
    }

    // Int: returnTotalMessagess() - typo in brief, keep exact name
    public static int returnTotalMessagess() {
        return sentMessages.size();
    }

    // storeMessage() method - Store in JSON file
    public void storeMessage() {
        try {
            FileWriter writer = new FileWriter("storedMessages.json", true);
            String json = "{\n" +
                          " \"MessageID\": \"" + messageID + "\",\n" +
                          " \"MessageHash\": \"" + messageHash + "\",\n" +
                          " \"Recipient\": \"" + recipient + "\",\n" +
                          " \"Message\": \"" + messageText.replace("\"", "\\\"") + "\"\n" +
                          "},\n";
            writer.write(json);
            writer.close();
        } catch (IOException e) {
            System.out.println("Error storing message to JSON file.");
        }
    }

    // checkMessageLength() - Returns exact strings from rubric
    public static String checkMessageLength(String message) {
        if (message.length() <= 250) {
            return "Message ready to send.";
        } else {
            int excess = message.length() - 250;
            return "Message exceeds 250 characters by " + excess + ", please reduce the size.";
        }
    }

    private String generateMessageID() {
        Random rand = new Random();
        String id = "";
        for (int i = 0; i < 10; i++) {
            id += rand.nextInt(10);
        }
        return id;
    }

    // Getters for JUnit tests abd it does not disturb the running of the program
    public String getMessageID() { return messageID; }
    public String getMessageHash() { return messageHash; }
    public int getMessageNum() { return messageNum; }
    public String getRecipient() { return recipient; }
    public String getMessageText() { return messageText; }
    public static ArrayList<Message> getSentMessages() { return sentMessages; }

    // For JUnit reset and it does not disturb the running of the program
    public static void resetCounters() {
        totalMessagesSent = 0;
        sentMessages.clear();
        storedMessages.clear();
        disregardedMessages.clear();
    }

